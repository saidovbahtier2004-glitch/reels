# Copy to .env (never commit .env). On hosting platforms, add these as
# "Environment variables / Secrets" instead of uploading a file.

# From @BotFather (required)
BOT_TOKEN=

# Song recognition: audd | acrcloud | none
RECOGNITION_PROVIDER=none

# --- if RECOGNITION_PROVIDER=audd ---
AUDD_API_TOKEN=

# --- if RECOGNITION_PROVIDER=acrcloud ---
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Optional
MAX_UPLOAD_MB=49
MAX_PARALLEL_JOBS=3
ITUNES_COUNTRY=US
